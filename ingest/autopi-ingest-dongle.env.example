# /etc/autopi-ingest.env OP DE DONGLE - chmod 600, root:root
#
# De standaardopstelling: de ontvanger draait op de dongle zelf. Firmware en
# eniro-soc posten lokaal; deze dienst houdt EEN MQTT-verbinding open naar
# jouw broker, door de WireGuard-tunnel (zie ../wireguard/). Een openstaande
# verbinding in plaats van twee nieuwe TLS-handshakes per vijf minuten.

# Alleen lokaal bereikbaar. Daarom hoeft het pad hier geen geheim te zijn.
# Moet gelijk zijn aan INGEST_URL in /etc/eniro-soc.env en de url in
# /etc/salt/minion.d/engines.conf: http://127.0.0.1:8181/ingest/lokaal
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8181
INGEST_PATH=/ingest/lokaal

# Jouw MQTT-broker, door wg0. Hetzelfde IP als <BROKER_IP> in
# /etc/wireguard/wg0.conf (AllowedIPs <BROKER_IP>/32).
MQTT_HOST=VUL_HIER_HET_BROKER_IP_IN
MQTT_PORT=1883
# Bij voorkeur een eigen login voor de dongle, zodat je hem los kunt
# intrekken als de dongle ooit weg is.
MQTT_USER=autopi-dongle
MQTT_PASS=VUL_HIER_HET_WACHTWOORD_IN
MQTT_PREFIX=autopi
MQTT_QOS=1

# Eigen client-ID. Draai je daarnaast ook de servervariant, dan mogen ze niet
# hetzelfde ID hebben, anders gooien ze elkaar bij de broker eruit.
MQTT_CLIENT_ID=autopi-ingest-dongle
# Elke keepalive gaat over 4G. 300 s houdt de verbinding levend zonder
# onnodig verkeer; de broker verbreekt pas na 1,5 x 300 s stilte.
MQTT_KEEPALIVE=300
# Last-will op een eigen topic: die vuurt elke keer dat de dongle gaat slapen.
# Op autopi/status zou dat HA-sensoren met dat availability_topic
# onbeschikbaar maken. Bruikbaar als "dongle online"-sensor in HA.
STATUS_TOPIC=autopi/dongle/status

# Kort houden: een request wacht per publicatie maximaal zo lang op de broker.
PUBLISH_TIMEOUT=5

# Geen ruwe payloads op de eMMC van de dongle.
RAW_DIR=

LOG_LEVEL=INFO

# Profielen (18-10-2026). HA zet het profiel retained op dit topic
# (bijvoorbeeld met een input_select en een automation). 'reis' = alles live;
# 'dagelijks' = op 4G per topic alleen de laatste waarde, elke
# BUNDEL_INTERVAL seconden in één keer. Op wifi altijd live. Laadrecords van
# eniro-soc gaan ook in 'dagelijks' direct door.
# Leeg laten (PROFIEL_TOPIC=) = functie uit, alles live.
PROFIEL_TOPIC=autopi/config/profiel
PROFIEL_STANDAARD=dagelijks
BUNDEL_INTERVAL=1800
# Gaat ook in 'dagelijks' direct door:
BUNDEL_UITZONDERINGEN=vehicle/battery/critical_level
METERED_IFACES=wwan0,ppp0
