# /etc/autopi-ingest.env — configuratie voor autopi-ingest
# Kopieer naar /etc/autopi-ingest.env en vul in. Rechten: chmod 600, root:root.
# Zet hier de enige geheimen: het ingest-pad en het MQTT-wachtwoord.

# Waar de dienst luistert. De Cloudflare-tunnel praat hier tegenaan.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8181

# Het geheime pad waarop de dongle post. Genereer met: openssl rand -hex 16
# Moet exact overeenkomen met de url in engines.conf op de dongle.
INGEST_PATH=/ingest/VUL_HIER_JE_HEX_IN

# MQTT-broker: de Mosquitto add-on op HAOS
MQTT_HOST=192.0.2.10
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASS=VUL_HIER_HET_WACHTWOORD_IN
MQTT_PREFIX=autopi
MQTT_QOS=1
PUBLISH_TIMEOUT=10

# Ruwe payloads bewaren voor debug. Leeg laten = uit.
RAW_DIR=/var/lib/autopi-ingest/raw
RAW_KEEP=200

# DEBUG geeft per record de topic en payload in het log.
LOG_LEVEL=INFO
