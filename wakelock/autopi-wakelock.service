[Unit]
Description=autopi-wakelock - houdt de dongle wakker zolang de auto hem voedt
Documentation=file:///opt/autopi-wakelock/README.md
After=salt-minion.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/autopi-wakelock/autopi_wakelock.py

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
LockPersonality=yes
StateDirectory=autopi-wakelock
