[Unit]
Description=autopi-diag - stuurt 4G- en routediagnostiek naar de ingest
Documentation=file:///opt/autopi-diag/README.md
After=network.target

[Service]
Type=oneshot
# Hergebruikt de env van eniro-soc, zodat het geheime ingest-pad op één plek staat.
EnvironmentFile=/etc/eniro-soc.env
Environment=USER_AGENT=autopi-diag/1.0
ExecStart=/usr/bin/python3 /opt/autopi-diag/autopi_diag.py

# Root omdat qmicli bij /dev/cdc-wdm0 moet. Verder zo weinig als mogelijk.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
StateDirectory=autopi-diag
ReadWritePaths=/var/lib/autopi-diag
