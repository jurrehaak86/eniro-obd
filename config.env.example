# config.env - alles wat install.sh van jou moet weten.
#
#   cp config.env.example config.env
#   chmod 600 config.env          # verplicht: install.sh weigert anders
#   nano config.env               # invullen
#   sudo ./install.sh --dry-run   # kijken wat er zou veranderen
#   sudo ./install.sh             # uitvoeren
#
# Dit bestand bevat wachtwoorden en sleutels. Het staat in .gitignore (*.env);
# deel het niet en zet het niet in een issue. scripts/wipe.sh wist het.
#
# Notatie: KEY=waarde, één per regel, geen spaties rond '='. Bevat een waarde
# spaties of rare tekens, zet hem dan tussen 'enkele' aanhalingstekens (of
# "dubbele" als er een ' in zit). Er wordt niets geëxpandeerd: $ en \ zijn
# gewone tekens. Commentaar alleen op een eigen regel.
# Leeg laten bij een veld met een standaardwaarde = de standaardwaarde.

# ---------------------------------------------------------------------------
# MQTT-broker thuis (INSTALLATIE 1.2)
# De eigen login voor de dongle die je in je broker aanmaakte. MQTT_HOST is
# het LAN-adres van de broker; hetzelfde adres gaat de WireGuard-tunnel door.
# ---------------------------------------------------------------------------
# verplicht, IPv4, bijvoorbeeld 192.168.1.10
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=autopi-dongle
# verplicht
MQTT_PASS=
MQTT_PREFIX=autopi

# ---------------------------------------------------------------------------
# WireGuard - neem de waarden over uit de .conf die je VPN-server voor de
# dongle maakte (INSTALLATIE 1.3). Een DNS-regel uit die .conf neem je níét over.
# ---------------------------------------------------------------------------
# verplicht: [Interface] Address, het tunneladres van de dongle, bv. 10.0.99.8/32
WG_ADDRESS=
# verplicht: [Interface] PrivateKey (44 tekens, eindigt op =)
WG_PRIVATE_KEY=
# verplicht: [Peer] PublicKey - de publieke sleutel van je VPN-server
WG_SERVER_PUBLIC_KEY=
# optioneel: [Peer] PresharedKey; leeg = geen
WG_PRESHARED_KEY=
# verplicht: [Peer] Endpoint, host:poort, bv. vpn.voorbeeld.nl:51820
WG_ENDPOINT=
# leeg = <MQTT_HOST>/32: alleen de broker door de tunnel (aanbevolen)
WG_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Hotspot van de dongle (INSTALLATIE 4.3). Dit is je weg naar binnen als de
# dongle op 4G zit; wie erop zit heeft via poort 9000 root. Wachtwoord:
# minimaal 16 tekens, uit je wachtwoordmanager.
# ---------------------------------------------------------------------------
# verplicht
HOTSPOT_SSID=
# verplicht, 8-63 tekens (16+ aanbevolen)
HOTSPOT_PSK=
HOTSPOT_COUNTRY=NL

# ---------------------------------------------------------------------------
# Wifi-netwerken waar de dongle zelf op inlogt (thuis, vakantieadres, travel
# router). Nummer ze door: WIFI_1_*, WIFI_2_*, WIFI_3_*, ... Een leeg blok
# wordt overgeslagen. Staat hier minstens één netwerk, dan wordt de lijst op
# de dongle precies deze lijst (in deze volgorde). Staat hier geen enkel
# netwerk, dan laat install.sh de wifi-instellingen ongemoeid.
# PRIORITY: optioneel, hoger = voorkeur. Open netwerken (zonder wachtwoord)
# worden niet ondersteund. Let op: de wachtwoorden komen in platte tekst in
# /etc/salt/grains te staan (zo werkt de firmware).
# ---------------------------------------------------------------------------
WIFI_1_SSID=
WIFI_1_PSK=
WIFI_1_PRIORITY=
WIFI_2_SSID=
WIFI_2_PSK=
WIFI_2_PRIORITY=

# ---------------------------------------------------------------------------
# SSH
# SSH_PUBKEY_n: publieke sleutels (de regel uit je ~/.ssh/id_ed25519.pub) die
# in /home/pi/.ssh/authorized_keys komen. Sleutels die er al staan blijven staan.
# SSH_WIFI_SUBNET: het netwerk waar je laptop op zit, bv. 192.168.1.0/24. Opent
# SSH (en ping) over wlan0, alleen vanaf dat netwerk (INSTALLATIE A.2).
# Leeg = de firewall niet aanraken.
# ---------------------------------------------------------------------------
SSH_PUBKEY_1=
SSH_WIFI_SUBNET=

# ---------------------------------------------------------------------------
# Gedrag. De standaardwaarden zijn de geteste; alleen aanpassen als je weet
# waarom. Toelichting in de .env.example-bestanden en INSTALLATIE bijlage A.3 en 7.5.
# ---------------------------------------------------------------------------
# Ontvanger (/etc/autopi-ingest.env): profiel 'dagelijks' bundelt op 4G per
# BUNDEL_INTERVAL seconden; 'reis' = alles live. Geldt tot HA een profiel stuurt.
BUNDEL_INTERVAL=1800
PROFIEL_STANDAARD=dagelijks
# eniro-soc (/etc/eniro-soc.env), in seconden
INTERVAL_CHARGING=300
INTERVAL_IDLE=1800
INTERVAL_UNMETERED=60
UPLOAD_WAIT=300
# Firmware (/etc/salt/minion.d/engines.conf)
# GPS-positie elke zoveel seconden (gnss_manager -> poll_logger)
GPS_INTERVAL=60
# wakker na een boot zonder rijdende motor (de twee inactivity-timers; fabriek 240).
# Rijden en laden houdt autopi-wakelock vast, dus dit geldt alleen voor wakes
# waarin niets gebeurt. Minder wakker = minder 12V-belasting. Tot v1.2.0: 3600.
INACTIVITY_PERIOD=900
# 12V-meting (spm_manager -> _battery_checker; was 5)
BATTERY_CHECK_INTERVAL=30
# bewegingsdrempel in g (was 0.01)
SHAKE_THRESHOLD=0.05
# 1 = spraakmeldingen uit (INSTALLATIE A.3.2)
SPRAAK_UIT=1
# 1 = ook autopi-diag installeren (4G-kwaliteit, optioneel)
DIAG_INSTALL=0

# ---------------------------------------------------------------------------
# Home Assistant: MQTT Discovery (INSTALLATIE, hoofdstuk Home Assistant)
# 1 = de ontvanger maakt de sensoren zelf aan in HA (twee apparaten, ~26
#     entiteiten); dan heb je homeassistant/eniro-mqtt.yaml NIET nodig.
# 0 = uit; je laadt eniro-mqtt.yaml zelf. Leeg of weggelaten = 0.
# Al eniro-mqtt.yaml in gebruik? Eerst die sensoren uit HA halen, dan pas 1 -
# anders dubbele unique_id's. --export-config op een bestaande dongle zet 0.
# ---------------------------------------------------------------------------
HA_DISCOVERY=1
# leeg = homeassistant (alleen aanpassen als je dat in de MQTT-integratie deed)
HA_DISCOVERY_PREFIX=
