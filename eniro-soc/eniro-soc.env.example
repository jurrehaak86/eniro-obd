# /etc/eniro-soc.env — configuratie voor eniro-soc op de AutoPi
# chmod 600, root:root.

# Waar de records naartoe gaan. Zelfde URL als in
# /etc/salt/minion.d/engines.conf onder cloud_manager.endpoint.
#
# Standaard: de ontvanger op de dongle zelf (zie ../ingest/). Lokaal, dus het
# pad is geen geheim; het moet wel gelijk zijn aan INGEST_PATH in
# /etc/autopi-ingest.env.
INGEST_URL=http://127.0.0.1:8181/ingest/lokaal
#
# Alternatief: een ontvanger op een eigen server achter HTTPS. Dan is het pad
# (32 hex, openssl rand -hex 16) wél het geheim, en is dit bestand gevoelig.
#INGEST_URL=https://autopi.voorbeeld.nl/ingest/VUL_HIER_JE_HEX_IN
HTTP_TIMEOUT=30

# CAN-bus. can0 is de OBD-bus; can1 is stil (vastgesteld 02-09-2026).
CAN_IFACE=can0
REQ_ID=0x7E4
RSP_ID=0x7EC
CAN_TIMEOUT=1.0

# De AutoPi brengt can0 NIET uit zichzelf omhoog — na een reboot staat hij DOWN,
# ook met een levende bus (gemeten 15-09-2026). Het script doet het daarom zelf.
# Zet CAN_AUTO_UP=0 als de AutoPi het ooit wel gaat doen.
CAN_BITRATE=500000
CAN_AUTO_UP=1
# Na een bus-off herstelt can0 alleen vanzelf als restart-ms > 0. Het script
# zet dit bij elke keer opbrengen (wijziging 13-10-2026).
CAN_RESTART_MS=100

# Kilometerstand: zit in de instrumentencluster, niet in de BMS.
# Gevonden 16-09-2026: 7C6 -> 7CE, DID B002, drie bytes big-endian op positie 6.
# De cluster antwoordt ALLEEN met het contact aan; tijdens laden is hij stil.
# Dat is geen bezwaar — afstand heb je nodig terwijl je rijdt.
ODO_REQ=0x7C6
ODO_RSP=0x7CE
ODO_OFFSET=6

# Extra aanleiding om te versturen: elke ODO_DELTA gereden kilometer een meetpunt.
# Tijdens rijden geeft dat een punt per kilometer, stilstaand niets. Nodig voor
# de verbruikscurve, die energie per afgelegde kilometer wil weten.
ODO_DELTA=1

# Lopend gemiddeld verbruik over de laatste honderd kilometer, netto (regen
# eraf), zoals het dashboard van de auto het ook doet. Komt mee als
# wh_per_km_100 zodra er genoeg kilometers achter de rug zijn.
#
# Waarom honderd: de kilometerteller telt in hele kilometers en de energieteller
# in tienden van kWh. Op tien kilometer is dat tien procent fout en koppelt die
# fout aan de gemeten snelheid — vandaar eerdere analyses waarin de auto
# zuiniger leek naarmate hij harder reed. Over honderd kilometer is het één
# procent.
VERBRUIK_VENSTER_KM=100
VERBRUIK_BEWAAR_KM=200
VERBRUIK_BESTAND=/var/lib/eniro-soc/verbruik.jsonl

# Pollintervallen in seconden, per voertuigstatus.
INTERVAL_DC=60
INTERVAL_DRIVING=60
INTERVAL_CHARGING=300
INTERVAL_IDLE=1800
INTERVAL_NO_BUS=300
# Net na het opstarten antwoordt de BMS soms nog niet. Dan STARTUP_WINDOW
# seconden lang elke INTERVAL_NO_BUS_START seconden opnieuw proberen. Kort
# gehouden: vragen aan een slapende auto kunnen zijn gateway wekken.
INTERVAL_NO_BUS_START=15
STARTUP_WINDOW=180

# Op wifi of ethernet kost data niets, dus mag alles sneller. AC-laden gebeurt
# vrijwel altijd thuis; dan geldt dit interval in plaats van INTERVAL_CHARGING.
INTERVAL_UNMETERED=60

# Meten en versturen zijn losgekoppeld. Een record is ~313 bytes, maar een
# TLS-verbinding kost ruwweg 5 KB — de kosten zitten in het aantal uploads.
# Records wachten UPLOAD_WAIT seconden in een uitbox en gaan dan samen in één
# POST. Rijden kost daarmee ~15 MB/jaar in plaats van ~82 MB.
# UPLOAD_WAIT_DC=0 betekent direct versturen tijdens snelladen: ~10 sessies per
# jaar (~1,5 MB), en juist het moment waarop je live naar de curve kijkt.
UPLOAD_WAIT=300
UPLOAD_WAIT_DC=0
OUTBOX_MAX=60

# Interfaces waarover data geld kost. Kan de default route niet bepaald worden,
# dan gaat het script uit van bemeten — falen doen we zuinig.
METERED_IFACES=wwan0,ppp0

# Databundel sparen: alleen versturen als de SOC met minstens SOC_DELTA
# verandert of een statusbit omklapt, en anders elke MAX_SILENCE seconden een
# hartslag. 500 MB voor 10 jaar is ~137 KB per dag.
SOC_DELTA=0.5
MAX_SILENCE=3600
# Tijdens laden minimaal elke 5 min een record, ook zonder SoC-verandering.
MAX_SILENCE_LADEN=300

# Lokale wachtrij als het versturen mislukt (geen bereik).
SPOOL_DIR=/var/lib/eniro-soc/spool
SPOOL_MAX=500

# Status voor autopi-wakelock (laden/snelladen/rijden/idle/geen bus). Die
# houdt de dongle wakker zolang dit bestand vers is en laden of rijden zegt.
STATUS_BESTAND=/var/lib/eniro-soc/status.json

LOG_LEVEL=INFO
